@startuml
hide footbox
participant "GoalsController" as p0
participant "GoalService" as p1
participant "JdbcSavingsGoalDao" as p2
participant "JDBC / SQLite" as p3
p0 -> p1: createGoal(userId, title, target, deadline, ratio)
p1 -> p1: validateSavingsGoal(...)
p1 -> p2: findActiveGoals(userId)
p2 --> p1: List<SavingsGoal>
p1 -> p1: check total active ratio <= 100%
p1 -> p2: save(new SavingsGoal(...))
p2 -> p3: INSERT savings_goals; generated key
p3 --> p2: generated id
p2 --> p1: saved goal
p1 --> p0: SavingsGoal
note over p0: Invalid input or excessive ratios throw before the INSERT.
@enduml