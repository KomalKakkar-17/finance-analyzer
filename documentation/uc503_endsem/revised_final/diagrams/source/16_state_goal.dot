digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", penwidth=1.4, nodesep="0.35", ranksep="0.55", fontname="Arial", fontsize=16];
node [shape=box, fontname="Arial", fontsize=14, color="#33465A", style="rounded,filled", fillcolor="#E7F3E8", margin="0.18,0.12", penwidth=1.4];
edge [fontname="Arial", fontsize=11, color="#33465A", arrowsize=0.8, penwidth=1.4];

 start [shape=circle,label="",width=.18,fillcolor="#247B75"];active [label="Active\nis_active = 1"];inactive [label="Inactive\nis_active = 0"];deleted [shape=box,label="Deleted\n(row absent)"];
 start->active [label="createGoal() [valid; total <=100%]"];active->inactive [label="toggleGoalActive() / deactivate"];inactive->active [label="toggleGoalActive() [ratio cap allows]"];active->active [label="allocateDeposit() / add saved_paise\nupdateGoal() [valid]"];inactive->inactive [label="updateGoal() [valid]"];active->deleted [label="deleteGoal()"];inactive->deleted [label="deleteGoal()"];


end [shape=doublecircle,label="",width=.2,fillcolor="#247B75"];deleted->end;
}
