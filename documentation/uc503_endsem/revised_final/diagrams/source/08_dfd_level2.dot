digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", penwidth=1.4, nodesep="0.35", ranksep="0.55", fontname="Arial", fontsize=16];
node [shape=box, fontname="Arial", fontsize=14, color="#33465A", style="filled", fillcolor="#E7F3E8", margin="0.18,0.12", penwidth=1.4];
edge [fontname="Arial", fontsize=11, color="#33465A", arrowsize=0.8, penwidth=1.4];

 node [shape=box,fillcolor="#DDF3F0",color="#247B75"];u [label="Account holder"];
 node [fillcolor="#E7F3E8",color="#387445",shape=circle,width=1.2];a [label="2.1\nValidate entry"];b [label="2.2\nPersist entry"];c [label="2.3\nFind records"];d [label="2.4\nManage categories\nand recurring rules"];
 store [fillcolor="#FFF0DE",color="#A36A26",shape=plain,label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD BORDER="1" SIDES="TB" BGCOLOR="#FFF0DE" CELLPADDING="8">D2 Categories / transactions / rules</TD></TR></TABLE>>];
 u->a [label="Transaction details"];a->b [label="Validated transaction"];a->u [label="Validation result"];store->a [label="Stored category"];b->store [label="Record changes"];b->u [label="Operation result"];
 u->c [label="Queries"];store->c [label="Stored records"];c->u [label="Records"];
 u->d [label="Category details; rule settings"];store->d [label="Stored records"];d->store [label="Record changes"];d->u [label="Operation results; records"];


u [fillcolor="#DDF3F0",color="#247B75"];
}
